{
  "manifest_version": 3,
  "default_locale": "en",
  "name": "__MSG_extName__",
  "short_name": "CookieLens",
  "description": "__MSG_extDesc__",
  "version": "0.4.2",
  "author": "CookieLens Contributors",
  "minimum_chrome_version": "102",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": ["cookies", "tabs", "storage", "sidePanel", "contextMenus", "offscreen", "alarms"],
  "optional_host_permissions": ["<all_urls>"],
  "commands": {
    "open-side-panel": {
      "suggested_key": { "default": "Alt+Shift+C" },
      "description": "__MSG_cmdOpenSidePanel__"
    },
    "export-site-json": {
      "suggested_key": { "default": "Alt+Shift+E" },
      "description": "__MSG_cmdExportSiteJson__"
    },
    "delete-site-cookies": {
      "suggested_key": { "default": "Alt+Shift+D" },
      "description": "__MSG_cmdDeleteSiteCookies__"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "__MSG_extName__",
    "default_popup": "interface/popup/cookie-list.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "side_panel": {
    "default_path": "interface/popup/cookie-list.html"
  },
  "devtools_page": "interface/devtools/devtools.html",
  "options_ui": {
    "page": "interface/options/options.html",
    "open_in_tab": true
  },
  "incognito": "split",
  "offline_enabled": true
}
